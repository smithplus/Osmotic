<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Hardened runtime resource access. Location: macOS only reveals the Wi-Fi network name to apps
	     with Location permission, and Osmotic needs it to put the Mac back on the user's network.
	     Camera: the Webcam tab shows the camera when it's plugged in by USB as a webcam. -->
	<key>com.apple.security.personal-information.location</key>
	<true/>
	<key>com.apple.security.device.camera</key>
	<true/>
</dict>
</plist>
