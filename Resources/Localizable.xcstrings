    "As a webcam, the picture goes over the cable in full quality and the camera charges. The Live tab works without the cable, over Wi-Fi, at preview quality.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Como webcam, la imagen va por el cable en calidad completa y la cámara se carga. La pestaña En vivo funciona sin cable, por Wi-Fi, en calidad de vista previa."
          }
        }
      }
    },
